<html lang="de"><script src="{{cookiecutter.cdn}}pythons.js" type=module id="site" data-python="python{{cookiecutter.PYBUILD}}" data-LINES=42 data-COLUMNS=132 data-os="snd,gui" async defer>#<!--

# Thalheimer is Among Us - Spielseite (von tools/build_web_client.py mit pygbag erzeugt).
# Dieser Python-Teil laeuft im Browser: er entpackt das Spiel und startet main.py.

import sys
import os
import asyncio
import platform
from pathlib import Path

# Python-Pakete (pygame) kommen vom eigenen Spielserver statt aus dem Internet -> klappt auch offline
# im WLAN. Das steuert "PYGPI=/cdn/" am Anfang der Seitenadresse (/play/?PYGPI=/cdn/&room=...),
# pygbag liest die Adress-Parameter beim Start als Umgebungsvariablen ein.


async def custom_site():
    import embed

    platform.window.tiauGame.loading("Spiel wird entpackt ...")
    platform.window.transfer.hidden = true
    platform.window.canvas.style.visibility = "visible"

    bundle = "{{cookiecutter.archive}}"
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    import tarfile
    async with platform.fopen("{{cookiecutter.archive}}.tar.gz", "rb") as archive:
        tar = tarfile.open(fileobj=archive, mode="r:gz")
        tar.extractall(path=appdir.as_posix(), filter='tar')
        tar.close()

    platform.run_main(PyConfig, loaderhome=appdir / "assets", loadermain=None)

    while embed.counter() < 0:
        await asyncio.sleep(.1)

    main = appdir / "assets" / "main.py"
    platform.window.tiauGame.loading("Spiel startet ...")

    await TopLevel_async_handler.start_toplevel(platform.shell, console=window.python.config.debug)
    __import__(__name__).__file__ = main

    def ui_callback(pkg):
        platform.window.tiauGame.loading(f"Lade {pkg} ...")

    await shell.source(main, callback=ui_callback)

    platform.window.infobox.style.display = "none"
    platform.window.config.gui_divider = 1
    platform.window.window_resize()

asyncio.run(custom_site())

